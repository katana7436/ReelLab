# Copy this file to .env (same folder) and fill in your own values. Never share .env.
# How to get them: README.md, section "Post to Instagram".

# Instagram account ID (a long number, NOT your @username)
IG_USER_ID=
# Long-lived access token with instagram_basic + instagram_content_publish (lasts about 60 days)
IG_ACCESS_TOKEN=
# Graph API version your Meta app uses
IG_API_VERSION=v23.0
